{
  "name": "W 声幕 · 手机播放器",
  "short_name": "W 声幕",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b1424",
  "theme_color": "#142139",
  "icons": [{ "src": "assets/logo.svg", "sizes": "any", "type": "image/svg+xml" }],
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "file", "accept": ["video/*", ".mp4", ".mov", ".webm", ".mkv"] }]
    }
  }
}
